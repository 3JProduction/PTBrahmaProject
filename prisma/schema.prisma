// ------------------------------------------------------
// Konfigurasi Client & Database Server
// ------------------------------------------------------
generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// ENUMS (Pilihan Statis)
// ------------------------------------------------------
enum Role {
  ADMIN_KANTOR
  PROJECT_MANAGER
  SITE_ENGINEER
  MANDOR
}

enum StatusApproval {
  PENDING
  APPROVED
  REJECTED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ------------------------------------------------------
// TABEL DATABASE UTAMA
// ------------------------------------------------------

// 1. Data Pengguna & Role
model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  role             Role
  createdAt        DateTime          @default(now())
  dailyReports     DailyReport[]
  materialRequests MaterialRequest[]
  issues           Issue[]
  comments         Comment[]
  activityLogs     ActivityLog[]
}

// 2. Data Proyek
model Project {
  id               String            @id @default(uuid())
  title            String
  description      String?
  location         String
  startDate        DateTime
  endDate          DateTime
  status           String            @default("ON_PROGRESS") // ON_PROGRESS, COMPLETED, HOLD
  progress         Int               @default(0) // TAMBAHKAN BARIS INI (Skala 0-100)
  createdAt        DateTime          @default(now())
  workItems        WorkItem[]
  dailyReports     DailyReport[]
  materialRequests MaterialRequest[]
  issues           Issue[]
}

// 3. Progress per Item Pekerjaan
model WorkItem {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id])
  itemName       String        // Contoh: "Pengecoran Kolom Lt. 1"
  unit           String        // Contoh: "m3", "m2", "unit"
  targetQuantity Float
  weightPercent  Float         // Bobot persen proyek (misal: 15%)
  progressLogs   ProgressLog[]
}

// 4. Laporan Harian (Daily Report) & Approval
model DailyReport {
  id           String         @id @default(uuid())
  projectId    String
  project      Project        @relation(fields: [projectId], references: [id])
  reporterId   String
  reporter     User           @relation(fields: [reporterId], references: [id])
  date         DateTime       @default(now())
  weather      String         // Cerah, Hujan, dll.
  notes        String?
  status       StatusApproval @default(PENDING)
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime       @default(now())
  progressLogs ProgressLog[]
  comments     Comment[]
}

// 5. Upload Foto/Video Progres & Progress Detail
model ProgressLog {
  id            String      @id @default(uuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id])
  workItemId    String
  workItem      WorkItem    @relation(fields: [workItemId], references: [id])
  quantityDone  Float
  mediaUrls     String[]    // Array URL foto/video dari Supabase Storage
}

// 6. Permintaan Material / Alat
model MaterialRequest {
  id          String         @id @default(uuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id])
  requesterId String
  requester   User           @relation(fields: [requesterId], references: [id])
  itemName    String
  quantity    Float
  unit        String
  status      StatusApproval @default(PENDING)
  createdAt   DateTime       @default(now())
}

// 7. Pelaporan Kendala (Issue Tracking)
model Issue {
  id          String        @id @default(uuid())
  projectId   String
  project     Project       @relation(fields: [projectId], references: [id])
  reporterId  String
  reporter    User          @relation(fields: [reporterId], references: [id])
  title       String
  description String
  severity    IssueSeverity @default(MEDIUM)
  isResolved  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  comments    Comment[]
}

// 8. Komentar & Diskusi
model Comment {
  id            String       @id @default(uuid())
  dailyReportId String?
  dailyReport   DailyReport? @relation(fields: [dailyReportId], references: [id])
  issueId       String?
  issue         Issue?       @relation(fields: [issueId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  message       String
  createdAt     DateTime     @default(now())
}

// 9. Notifikasi
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// 10. Riwayat Aktivitas (Audit Log)
model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String   // Contoh: "CREATE_DAILY_REPORT", "APPROVE_MATERIAL"
  details   String
  createdAt DateTime @default(now())
}